{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nwise-kit:schema:suggestions:1",
  "title": "NwiseKit suggestions",
  "description": "Configurations recommended to supplement an existing matrix, with the coverage each would add. Projected coverage is hypothetical: it counts only once the tests exist, have assertions and run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "toolVersion",
    "kind",
    "algorithm",
    "basis",
    "runId",
    "modelId",
    "strength",
    "modelHash",
    "matrixHash",
    "target",
    "maxNewCases",
    "baseline",
    "recommendations",
    "projected",
    "targetReached",
    "suggestionComplete",
    "stopReason",
    "remaining",
    "work",
    "diagnostics",
    "limits",
    "durationMs"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "toolVersion": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "suggestions"
    },
    "algorithm": {
      "const": "greedy-v1"
    },
    "basis": {
      "enum": ["declared", "observed", "passed"]
    },
    "runId": {
      "type": ["string", "null"],
      "description": "The run whose evidence was the starting point; null for the declared basis."
    },
    "modelId": {
      "type": "string",
      "minLength": 1
    },
    "strength": {
      "enum": [2, 3]
    },
    "modelHash": {
      "$ref": "#/$defs/sha256"
    },
    "matrixHash": {
      "$ref": "#/$defs/sha256"
    },
    "target": {
      "type": "string",
      "pattern": "^(?:100(?:\\.0{1,3})?|\\d{1,2}(?:\\.\\d{1,3})?)$"
    },
    "maxNewCases": {
      "$ref": "#/$defs/positiveInteger"
    },
    "baseline": {
      "$ref": "#/$defs/metric"
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "values",
          "indices",
          "matchedCaseIds",
          "previousOutcomes",
          "gain",
          "projected"
        ],
        "properties": {
          "kind": {
            "enum": ["add-case", "rerun-existing"]
          },
          "values": {
            "type": "object",
            "additionalProperties": {
              "type": ["string", "number", "boolean"]
            }
          },
          "indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "matchedCaseIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "previousOutcomes": {
            "type": "array",
            "description": "How each matched case ended in the run, for rerun-existing recommendations from a runtime basis.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["caseId", "outcome"],
              "properties": {
                "caseId": {
                  "type": "string"
                },
                "outcome": {
                  "type": "string"
                }
              }
            }
          },
          "gain": {
            "$ref": "#/$defs/positiveInteger"
          },
          "projected": {
            "$ref": "#/$defs/metric"
          }
        }
      }
    },
    "projected": {
      "$ref": "#/$defs/metric"
    },
    "targetReached": {
      "type": "boolean"
    },
    "suggestionComplete": {
      "type": "boolean"
    },
    "stopReason": {
      "enum": ["target-reached", "case-budget", "work-budget"]
    },
    "remaining": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/interaction"
      }
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": ["used", "budget"],
      "properties": {
        "used": {
          "type": "integer",
          "minimum": 0
        },
        "budget": {
          "$ref": "#/$defs/positiveInteger"
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxParameters",
        "maxRawConfigurations",
        "maxValidConfigurations",
        "maxInteractions",
        "maxConstraintDepth",
        "maxConstraintNodes",
        "analysisTimeMs",
        "suggestionWork"
      ],
      "properties": {
        "maxParameters": {
          "$ref": "#/$defs/positiveInteger"
        },
        "maxRawConfigurations": {
          "$ref": "#/$defs/positiveInteger"
        },
        "maxValidConfigurations": {
          "$ref": "#/$defs/positiveInteger"
        },
        "maxInteractions": {
          "$ref": "#/$defs/positiveInteger"
        },
        "maxConstraintDepth": {
          "$ref": "#/$defs/positiveInteger"
        },
        "maxConstraintNodes": {
          "$ref": "#/$defs/positiveInteger"
        },
        "analysisTimeMs": {
          "$ref": "#/$defs/positiveInteger"
        },
        "suggestionWork": {
          "$ref": "#/$defs/positiveInteger"
        }
      }
    },
    "durationMs": {
      "type": "number",
      "minimum": 0
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["covered", "total", "percentage"],
      "properties": {
        "covered": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 1
        },
        "percentage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameters", "indices", "values"],
      "properties": {
        "parameters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "indices": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "values": {
          "type": "array",
          "items": {
            "type": ["string", "number", "boolean"]
          }
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": {
          "type": "string"
        },
        "severity": {
          "enum": ["error", "warning"]
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "caseIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hint": {
          "type": "string"
        }
      }
    }
  }
}
