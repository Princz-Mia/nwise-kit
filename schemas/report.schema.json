{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nwise-kit:schema:report:1",
  "title": "NwiseKit report",
  "description": "A self-contained coverage report. Counts are authoritative and percentages are derived from them. When a report is read back, the tool recomputes every count from the embedded model and matrix and rejects any difference.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "toolVersion",
    "kind",
    "model",
    "matrix",
    "modelHash",
    "matrixHash",
    "strength",
    "analysisComplete",
    "runtimeComplete",
    "runId",
    "filters",
    "universe",
    "metrics",
    "profile",
    "groups",
    "missing",
    "diagnostics",
    "limits",
    "durationMs"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "toolVersion": { "type": "string", "minLength": 1 },
    "kind": { "const": "static" },
    "model": { "$ref": "urn:nwise-kit:schema:model:1" },
    "matrix": { "$ref": "urn:nwise-kit:schema:matrix:1" },
    "modelHash": { "$ref": "#/$defs/sha256" },
    "matrixHash": { "$ref": "#/$defs/sha256" },
    "strength": { "enum": [2, 3] },
    "analysisComplete": { "const": true },
    "runtimeComplete": { "const": null },
    "runId": { "const": null },
    "filters": { "const": null },
    "universe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rawConfigurations", "validConfigurations", "interactions"],
      "properties": {
        "rawConfigurations": { "type": "integer", "minimum": 1 },
        "validConfigurations": { "type": "integer", "minimum": 1 },
        "interactions": { "type": "integer", "minimum": 1 }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared", "observed", "passed"],
      "properties": {
        "declared": { "$ref": "#/$defs/metric" },
        "observed": { "$ref": "#/$defs/optionalMetric" },
        "passed": { "$ref": "#/$defs/optionalMetric" }
      }
    },
    "profile": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["strength", "declared", "observed", "passed"],
        "properties": {
          "strength": { "type": "integer", "minimum": 1, "maximum": 3 },
          "declared": { "$ref": "#/$defs/metric" },
          "observed": { "$ref": "#/$defs/optionalMetric" },
          "passed": { "$ref": "#/$defs/optionalMetric" }
        }
      }
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["parameters", "declared", "observed", "passed"],
        "properties": {
          "parameters": { "type": "array", "items": { "type": "string" } },
          "declared": { "$ref": "#/$defs/metric" },
          "observed": { "$ref": "#/$defs/optionalMetric" },
          "passed": { "$ref": "#/$defs/optionalMetric" }
        }
      }
    },
    "missing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared", "observed", "passed"],
      "properties": {
        "declared": { "type": "array", "items": { "$ref": "#/$defs/interaction" } },
        "observed": { "const": null },
        "passed": { "const": null }
      }
    },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxParameters",
        "maxRawConfigurations",
        "maxValidConfigurations",
        "maxInteractions",
        "maxConstraintDepth",
        "maxConstraintNodes",
        "analysisTimeMs",
        "suggestionWork"
      ],
      "properties": {
        "maxParameters": { "$ref": "#/$defs/positiveInteger" },
        "maxRawConfigurations": { "$ref": "#/$defs/positiveInteger" },
        "maxValidConfigurations": { "$ref": "#/$defs/positiveInteger" },
        "maxInteractions": { "$ref": "#/$defs/positiveInteger" },
        "maxConstraintDepth": { "$ref": "#/$defs/positiveInteger" },
        "maxConstraintNodes": { "$ref": "#/$defs/positiveInteger" },
        "analysisTimeMs": { "$ref": "#/$defs/positiveInteger" },
        "suggestionWork": { "$ref": "#/$defs/positiveInteger" }
      }
    },
    "durationMs": { "type": "number", "minimum": 0 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "positiveInteger": { "type": "integer", "minimum": 1 },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["covered", "total", "percentage"],
      "properties": {
        "covered": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 1 },
        "percentage": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "optionalMetric": {
      "description": "Null when the metric is unavailable, which is different from zero coverage.",
      "oneOf": [{ "$ref": "#/$defs/metric" }, { "type": "null" }]
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameters", "indices", "values"],
      "properties": {
        "parameters": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "indices": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "values": { "type": "array", "items": { "type": ["string", "number", "boolean"] } }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": { "type": "string" },
        "severity": { "enum": ["error", "warning"] },
        "message": { "type": "string" },
        "path": { "type": "string" },
        "caseIds": { "type": "array", "items": { "type": "string" } },
        "hint": { "type": "string" }
      }
    }
  }
}
